# Backend Environment Variables

# Node Environment
NODE_ENV=development
PORT=3000

# PostgreSQL Database (local or remote)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://resilio_user:resilio_dev@localhost:5432/resilio

# JWT Token Configuration
# Use strong random secrets in production (at least 32 characters)
JWT_ACCESS_SECRET=your-strong-secret-key-min-32-chars
JWT_REFRESH_SECRET=your-strong-refresh-secret-key-min-32-chars
JWT_ISSUER=auth.yourdomain.com
JWT_AUDIENCE=api.yourdomain.com

# JWT Expiry Times
# Access token: 15 minutes (900 seconds) - short-lived for security
# Refresh token: 7 days (604800 seconds) - longer-lived, stored in HttpOnly cookie
JWT_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# CORS Configuration
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# API Configuration
API_RATE_LIMIT_PER_SECOND=10
SYNC_RATE_LIMIT_PER_SECOND=1

# Logging
LOG_LEVEL=info
